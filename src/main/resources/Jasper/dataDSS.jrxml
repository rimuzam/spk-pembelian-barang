	<queryString>
		<![CDATA[SELECT
    s.kode_sub,
    s.nama_sub,
    s.sub_nilai,
    s.kode_kriteria,
    k.nama_kriteria
FROM 
    sub_criteria s
JOIN 
    kriteria k ON s.kode_kriteria = k.kode_kriteria
ORDER BY 
    s.kode_kriteria, s.kode_sub;]]>
	</queryString>
